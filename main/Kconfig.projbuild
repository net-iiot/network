menu "Wetzel Mesh"
    choice
        prompt "Device Role"
        default WM_ROLE_NODE_RELAY
        config WM_ROLE_GATEWAY
            bool "Gateway (Wi-Fi+HTTP+UART)"
        config WM_ROLE_NODE_EDGE
            bool "Node de Borda (BLE+UART+Mesh)"
        config WM_ROLE_NODE_RELAY
            bool "Node Relay (Mesh apenas)"
        config WETZEL_ENABLE_BLE
            bool "Enable BLE transport"
    endchoice
endmenu
